{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thaana PDF to Word",
  "version": "../package.json",
  "identifier": "mv.thaanaocr.pdftoword",
  "build": {
    "frontendDist": "../renderer",
    "beforeBuildCommand": "node scripts/vendor.mjs",
    "beforeDevCommand": "node scripts/vendor.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Thaana PDF to Word",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Dhivehi (Thaana) PDFs and scans to Word",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "Copyright 2026 the Thaana PDF to Word authors. Apache-2.0.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
